{
    "name": "tcp_pooled_32_new",
    "protocol": "tcp",
    "server": {
        "hostname": "amd103.utah.cloudlab.us",
        "user": "varunm"
    },
    "clients": [
        {"hostname": "amd110.utah.cloudlab.us", "user": "varunm"},
        {"hostname": "amd109.utah.cloudlab.us", "user": "varunm"},
        {"hostname": "amd108.utah.cloudlab.us", "user": "varunm"},
        {"hostname": "amd101.utah.cloudlab.us", "user": "varunm"}
    ],
    "binary_dir": "./build",
    "output_dir": "./results/tcp_pooled_32_new",
    "params": {
        "port": 9000,
        "pool_size": 32,
        "dctcp": false,
        "scheduling": "size_aware",
        "dist": "bimodal",
        "arrival": "closed",
        "msg_size": 1024,
        "bimodal_small": 256,
        "bimodal_large": 4194304,
        "bimodal_ratio": 0.1,
        "requests": 100000,
        "warmup": 5000,
        "cpu_monitor": true
    }
